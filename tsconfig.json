{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "lib": ["ESNext"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
