{
  "name": "oisiicord",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.6"
  },
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "test": "bun test",
    "check": "tsc --noEmit",
    "test:browser": "bun tests/browser.mjs",
    "test:interface": "bun tests/interface.mjs",
    "update": "bun src/maintenance.ts update",
    "backup": "bun src/maintenance.ts backup",
    "data": "bun src/maintenance.ts data",
    "test:retention": "bun tests/retention.mjs",
    "test:community": "bun tests/community-interface.mjs",
    "test:history": "bun tests/history-interface.mjs",
    "test:login": "bun tests/login-interface.mjs",
    "test:workspace": "bun tests/workspace-interface.mjs",
    "test:productivity": "bun tests/productivity-interface.mjs",
    "test:developer": "bun tests/developer-interface.mjs"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "playwright": "1.64.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "mermaid": "12.2.0",
    "highlight.js": "11.12.0"
  }
}
